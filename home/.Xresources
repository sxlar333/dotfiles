! 2bwm theme — Catppuccin Mocha base
! 2bwm reads these at startup. Restart 2bwm after changing them.
!
! The values here override the fallback colors in config.h.

twobwm.border_width:       4
twobwm.outer_border:       2

twobwm.focus_color:        #89b4fa
twobwm.unfocus_color:      #45475a
twobwm.fixed_color:        #a6e3a1
twobwm.unkill_color:       #f38ba8
twobwm.fixed_unkill_color: #f9e2af
twobwm.outer_border_color: #1e1e2e

twobwm.inverted_colors:    true

! Set this to true if you run picom/compton so transparency works.
twobwm.enable_compton:     false
